	keywords = {Applied mathematics, Electrical and electronic engineering, Mechanical engineering},
	pages = {8420},
	file = {Full Text PDF:C\:\\Users\\Manuel\\Zotero\\storage\\UT7DIN4F\\Liu et al. - 2026 - Method for classification of UAV flight control RF signals based on multi-scale divergence entropy a.pdf:application/pdf},
