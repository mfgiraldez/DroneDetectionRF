}

@article{zhang_entropy-based_1989,
	title = {An entropy-based receiver for the detection of random signals and its application to radar},
	volume = {18},
	issn = {0165-1684},
	url = {https://www.sciencedirect.com/science/article/pii/0165168489900819},
	doi = {10.1016/0165-1684(89)90081-9},
	abstract = {An entropy-based receiver is derived for detecting correlated signals in additive white noise, both having unknown statistics. The basic idea behind the new approach is that under a constant energy constraint, the entropy of a received process having a finite number of sample points attains its maximum when the process is white and decreases as it becomes correlated. When no signal is present, the test statistic is asymptotically a monotone function of a chi-square variable, which can be employed to determine the desired threshold for a constant false-alarm rate. Results based on simulated data and actual radar data are presented.
Zusammenfassung
Ein entropie orientierter Empfänger zur Erkennung korrelierter Signale mit additivem weißen Rauschen wird vorgestellt. Die Signalstatistik ist weder beim Nutz- noch beim Störanteil bekannt. Die grundlegende Idee hinter diesem neuen Ansatz liegt darin, daß unter der Bedingung konstanter Energie die Entropie-Rate eines empfangenen Prozesses maximal wird, wenn der Prozeß weiß ist, und bei zunehmender Korrelation abnimmt. Die Test-Statistik, ist asymptotisch eine monotone Funktion einer Chi-Quadrat Variablen, wenn kein Signal vorhanden ist. Dies kann zur Bestimmung der Schwelle für eine konstante Falsch-Alarm-Rate verwendet werden. Ergebnisse, die sowohl mit simulierten als auch mit echten Radar-Daten gewonnen wurden, werden vorgestellt.
Résumé
Ce texte décrit un récepteur à maximum d'entropie pour la détection de signaux corrélés dans du bruit blanc additif, ceci dans le cas où aucune statistique n'est connue. L'idée de base de cette nouvelle approche est que soumise à une contrainte d'énergie constante, l'entropie du processus reçu, composé d'un nombre fini d'échantillons, atteint son maximum quand ce processus est blanc et décroît lorsqu'il devient corrélé. Quand le signal est absent, la statistique de test est asymptotiquement une fonction monotone d'une variable de type Chi-deux, ce qui peut être utilisé pour la détermination d'un seuil assurant un taux de fausse alarme constant. Des résultats sur des données simulées et des données rader réelles sont présentés.},
	number = {4},
	urldate = {2026-03-28},
	journal = {Signal Processing},
	author = {Zhang, Q. T},
	month = dec,
	year = {1989},
	keywords = {Signal detection, signal processing, entropy-based receiver, radar detection},
	pages = {387--396},
	file = {ScienceDirect Snapshot:C\:\\Users\\Manuel\\Zotero\\storage\\B58CI3SU\\0165168489900819.html:text/html},
}

@article{liu_method_2026,
	title = {Method for classification of {UAV} flight control {RF} signals based on multi-scale divergence entropy and optimized neural networks},
	volume = {16},
