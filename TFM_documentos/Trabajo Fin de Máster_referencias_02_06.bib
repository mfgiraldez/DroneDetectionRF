@article{allahham_dronerf_2019,
	title = {{DroneRF} dataset: {A} dataset of drones for {RF}-based detection, classification and identification},
	volume = {26},
	issn = {2352-3409},
	shorttitle = {{DroneRF} dataset},
	doi = {10.1016/j.dib.2019.104313},
	abstract = {Modern technology has pushed us into the information age, making it easier to generate and record vast quantities of new data. Datasets can help in analyzing the situation to give a better understanding, and more importantly, decision making. Consequently, datasets, and uses to which they can be put, have become increasingly valuable commodities. This article describes the DroneRF dataset: a radio frequency (RF) based dataset of drones functioning in different modes, including off, on and connected, hovering, flying, and video recording. The dataset contains recordings of RF activities, composed of 227 recorded segments collected from 3 different drones, as well as recordings of background RF activities with no drones. The data has been collected by RF receivers that intercepts the drone's communications with the flight control module. The receivers are connected to two laptops, via PCIe cables, that runs a program responsible for fetching, processing and storing the sensed RF data in a database. An example of how this dataset can be interpreted and used can be found in the related research article "RF-based drone detection and identification using deep learning approaches: an initiative towards a large open source drone database" (Al-Sa'd et al., 2019).},
	language = {eng},
	journal = {Data in Brief},
	author = {Allahham, Mhd Saria and Al-Sa'd, Mohammad F. and Al-Ali, Abdulla and Mohamed, Amr and Khattab, Tamer and Erbad, Aiman},
	month = oct,
	year = {2019},
	keywords = {UAV detection, Anti-drone systems, Classification, Drone identification},
	pages = {104313},
	file = {Texto completo:C\:\\Users\\Manuel\\Zotero\\storage\\FKIR2EC3\\Allahham et al. - 2019 - DroneRF dataset A dataset of drones for RF-based detection, classification and identification.pdf:application/pdf},
}

@inproceedings{wang_radio_2025,
	title = {Radio {Frequency} {Fingerprinting} {Identification} for {Drones} {Based} on the {Generalized} {S}-{Transform}},
	url = {https://ieeexplore.ieee.org/document/11108383/},
	doi = {10.1109/ICNLP65360.2025.11108383},
	abstract = {The rapid proliferation of Unmanned Aerial Vehicles (UAVs) has introduced critical safety concerns, while traditional UAVs identification approaches have proven inadequate in addressing these challenges. As a result, integrating radio frequency (RF) signal recognition with deep learning has become a critical research focus. This study presents a novel deep learning-based RF signal recognition framework that adeptly addresses the non-stationary nature of UAVs RF signals by transforming raw in-phase/quadrature (I/Q) samples into spectrograms using the Generalized S-transform. Furthermore, the framework introduces a novel data augmentation technique called Phase-Shift Data Augmentation (PSDA), improving the model's robustness. The proposed approach is anticipated to deliver an effective solution for UAVs management and control, with the PSDA method demonstrating superior performance across specific signal-to-noise ratio (SNR) ranges compared to existing Radio Frequency Fingerprinting identification(RFFI) techniques.},
	urldate = {2026-02-25},
	booktitle = {2025 7th {International} {Conference} on {Natural} {Language} {Processing} ({ICNLP})},
	author = {Wang, Jingxu and Lu, Guangyue and Mi, Yin},
	month = mar,
	year = {2025},
	keywords = {deep learning, Drones, RF signals, Autonomous aerial vehicles, Drone RF fingerprint recognition, Fingerprint recognition, Generalized S-transform, PSDA method, Radio frequency, Radiofrequency identification, Robustness, Signal to noise ratio, Spectrogram, Vehicle dynamics},
	pages = {426--431},
	file = {Full Text PDF:C\:\\Users\\Manuel\\Zotero\\storage\\E9RMEWIA\\Wang et al. - 2025 - Radio Frequency Fingerprinting Identification for Drones Based on the Generalized S-Transform.pdf:application/pdf},
}

@inproceedings{zhao_drone_2024,
	title = {Drone {RF} {Signal} {Detection} and {Fingerprinting}: {UAVSig} {Dataset} and {Deep} {Learning} {Approach}},
	issn = {2155-7586},
	shorttitle = {Drone {RF} {Signal} {Detection} and {Fingerprinting}},
	url = {https://ieeexplore.ieee.org/document/10773837/},
	doi = {10.1109/MILCOM61039.2024.10773837},
	abstract = {Unmanned aerial vehicles (UAVs) are useful for commercial, recreational, and military applications, but they can also be used by malicious attackers and pose security threats. Therefore, it is important to monitor their occurrences and ensure their compliance. Radio frequency signals can be leveraged for such task. However, commercial UAVs often adopt the frequency hopping spread spectrum signals and proprietary protocols, which makes them more challenging to detect. While prior works have studied the UAV detection and classification problem, most of them consider the classification between different UAV models. Classification between drones of the same model has not yet fully been investigated. In this work, we consider the tasks of detecting and localizing UAV signals in a wideband spectrum, and also the task of fingerprinting these drones of the same model simultaneously. To solve this problem, we collect the UAVSig, an over-the-air dataset of UAV RF signals. We also present a deep learning model which can solve detect and fingerprint multiple drones of the same model simultaneously based on spectrograms. Our model can achieve 99.5\% precision and 99.4\% recall for transmission detection, and 90.9\% classification accuracy with drones of the same model.},
	urldate = {2026-02-25},
	booktitle = {{MILCOM} 2024 - 2024 {IEEE} {Military} {Communications} {Conference} ({MILCOM})},
	author = {Zhao, Tianyi and Domae, Benjamin W. and Steigerwald, Connor and Paradis, Luke B. and Chabuk, Tim and Cabric, Danijela},
	month = oct,
	year = {2024},
	note = {ISSN: 2155-7586},
	keywords = {deep learning, Deep learning, Drones, RF signals, Autonomous aerial vehicles, Fingerprint recognition, Radio frequency, Spectrogram, Accuracy, Analytical models, dataset, Radio frequency fingerprinting, Security, UAV, unmanned aerial vehicles, YOLO},
	pages = {431--436},
	file = {Full Text PDF:C\:\\Users\\Manuel\\Zotero\\storage\\Y6DD8LXY\\Zhao et al. - 2024 - Drone RF Signal Detection and Fingerprinting UAVSig Dataset and Deep Learning Approach.pdf:application/pdf},
}

